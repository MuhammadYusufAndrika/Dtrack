APP_NAME=FleetVisionAI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=fleetvision
DB_USERNAME=fleetvision
DB_PASSWORD=fleetvision_secret

BROADCAST_DRIVER=reverb
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

REVERB_APP_ID=fleetvision-reverb
REVERB_APP_KEY=fleetvision-key
REVERB_APP_SECRET=fleetvision-secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=*

FLEETVISION_SPEED_THRESHOLD=120
FLEETVISION_MAX_DRIVING_DURATION=14400
FLEETVISION_LOCATION_POLLING_INTERVAL=5
FLEETVISION_ALERT_RETENTION_DAYS=90

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,backend

# Live camera — kosongkan = auto (local pakai http://host:5000, hosting https pakai /ai proxy)
# Contoh hosting: VITE_AI_SERVICE_URL=https://domain.com/ai
VITE_AI_SERVICE_URL=
VITE_AI_SERVICE_WS=
VITE_LIVE_POLL_MS=600
VITE_AI_SEND_MS=500

# Peta — kosongkan = Esri gratis tanpa key. Contoh ganti OSM / CARTO ber-key:
# VITE_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
VITE_MAP_TILES_URL=
VITE_MAP_ATTRIBUTION=

# TWA / Digital Asset Links (isi setelah punya domain + keystore)
TWA_PACKAGE=com.fleetvisionai.twa
TWA_SHA256_1=
TWA_SHA256_2=
